# ==========================================
# Real Estate Lead Engine Configuration
# ==========================================

# Your Name for email signature
SENDER_NAME=Hamzha

# Your Portfolio URL to showcase web development work
PORTFOLIO_URL=https://yourportfolio.dev

# Sender Gmail / Workspace Address
SENDER_EMAIL=yourname@gmail.com

# 16-character Gmail App Password (NOT your real login password)
# Generated from: https://myaccount.google.com/apppasswords
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Mode: Set to False when you are ready to send real emails, True for safe testing
DRY_RUN=True

# Daily safe email limit (recommended: 15-25)
MAX_DAILY_EMAILS=20

# Delay between emails (seconds) to prevent spam flags
EMAIL_DELAY_SEC=3.0

# Optional Google Maps API key
GOOGLE_MAPS_API_KEY=
